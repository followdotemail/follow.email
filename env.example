# ============================================
# SHARED CONFIGURATION
# ============================================

# Application Ports
FRONTEND_PORT=3000
BACKEND_PORT=8080

# ============================================
# FRONTEND CONFIGURATION (Next.js)
# ============================================

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# BACKEND CONFIGURATION (Go)
# ============================================

# Server Configuration
PORT=8080
GIN_MODE=debug
CORS_ORIGINS=http://localhost:3000

# Database Configuration (External - Neon, Supabase, etc.)
DATABASE_URL=postgresql://username:password@hostname:5432/follow_email?sslmode=require

# Clerk Authentication (Backend)
# Note: Use the same CLERK_SECRET_KEY as frontend

# Clerk Webhook
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/gmail/callback

# AWS S3 Configuration (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your_s3_bucket_name

# Google Gemini AI Configuration (Optional)
GEMINI_API_KEY=your_gemini_api_key

# Upstash QStash Configuration (Optional)
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=your_qstash_token

# Encryption
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# Environment
ENVIRONMENT=development

# ============================================
# CLOUD PROVISIONING CONFIGURATION (Optional)
# Required only for automated deployment via provision-dev-instance.py
# ============================================

# Excloud Configuration
# Get these from: https://excloud.in/
EXCLOUD_API_KEY=your_excloud_api_key_here
EXCLOUD_API_URL=https://compute.excloud.in
EXCLOUD_IMAGE_ID=10
EXCLOUD_ZONE_ID=1
EXCLOUD_SUBNET_ID=1273
EXCLOUD_PROJECT_ID=1
EXCLOUD_SECURITY_GROUP_ID=1624
EXCLOUD_SSH_PUBKEY="ssh-ed25519 AAAAC3... your-email@example.com"

# Spaceship DNS Configuration
# Get these from: https://spaceship.dev/
SPACESHIP_API_KEY=your_spaceship_api_key
SPACESHIP_API_SECRET=your_spaceship_api_secret

# GitHub Repository (for provisioning)
GITHUB_REPO=https://github.com/followdotemail/follow.email.git






#python provision-dev-instance.py --action create --record-name api
#python provision-dev-instance.py --action destroy --instance-id <instance_id>